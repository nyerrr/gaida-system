OPENAI_API_KEY=sk-REPLACE-WITH-YOUR-KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=REPLACE-WITH-YOUR-SUPABASE-KEY
GOOGLE_CLIENT_ID=REPLACE-WITH-YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com

# Counselor alert emails (Crisis/High severity) — see app/services/notifications.py.
# If any of these are left blank, alert emails are silently skipped and only
# the Counselor Dashboard's Alerts list still works, as before.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE-WITH-SENDER-ADDRESS@gmail.com
SMTP_PASSWORD=REPLACE-WITH-APP-PASSWORD
ALERT_FROM_EMAIL=REPLACE-WITH-SENDER-ADDRESS@gmail.com
COUNSELOR_ALERT_EMAILS=counselor1@ue.edu.ph,counselor2@ue.edu.ph
FRONTEND_URL=http://localhost:5173
# Set to "development" to enable /docs, /redoc, /openapi.json locally.
# Leave unset (or "production") on any deployed/live backend — this
# defaults to production (docs disabled) when unset, so a deployment that
# forgets to set this stays safe by default.
ENVIRONMENT=development

# ── Voice cleaning (before acoustic feature extraction) ─────────────────────
# Denoise (stationary spectral gating via noisereduce) + loudness-normalize
# every recording before jitter/shimmer/pitch feature extraction. Set to 0 to
# restore the raw pipeline (identical behavior to pre-cleaning builds).
GAIDA_VOICE_CLEANING=1
# Noise-removal strength (0 = none, 1 = full). 0.75 is conservative so speech
# content and tremor statistics are not distorted.
GAIDA_NOISE_PROP_DECREASE=0.75
# Stationary noise-gate std threshold (higher = keeps more, less aggressive).
GAIDA_NOISE_N_STD_THRESH=1.5
# Target loudness (RMS) after normalization. Keep downstream thresholds
# meaningful: silence cutoff = 0.2x, sad energy < 0.4x, angry energy > 1.6x.
GAIDA_VOICE_NORM_TARGET_RMS=0.05
