VITE_GOOGLE_CLIENT_ID=REPLACE-WITH-YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com

# Backend origin the app calls. This is read at BUILD time and baked into the
# bundle, so changing it requires a rebuild/redeploy — it is not read at runtime.
#
# Local development (Vite on 5173, FastAPI on 8000):
# VITE_BACKEND_URL=http://localhost:8000
#
# Production (the Replit-hosted FastAPI backend):
VITE_BACKEND_URL=https://gaida-system--rainierburlasa4.replit.app
#
# Set this in Project Settings -> Environment Variables for Vercel and redeploy.
#
# Two traps worth knowing about:
#   * If it is unset, src/config.js falls back to `http://<the page's own
#     hostname>:8000`. There is no backend on port 8000 of the Vercel host, so
#     a build with no VITE_BACKEND_URL is broken by construction — never rely
#     on the fallback for a deployed build.
#   * The backend's CORS allowlist (backend/app/main.py ALLOWED_ORIGINS) must
#     include this frontend's origin, or the browser blocks the response even
#     though the backend is up. `https://gaida-system.vercel.app` is already in
#     that list.
#
# Note: the Replit deployment sleeps when idle, so the first request after a
# quiet period can take 30-60 s while it wakes. Verified reachable: GET / on
# the URL above returns {"status":"ok","message":"GAIDA Backend"}.
