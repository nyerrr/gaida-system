OPENAI_API_KEY=sk-REPLACE-WITH-YOUR-KEY

# ── Chat model (the fine-tuned / open-weight model that writes replies) ──
# gpt_agent.py accepts either naming convention.
#
# Fine-tuned OpenAI model:
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL=ft:gpt-4.1-mini:your-org:gaida:xxxx
#   (leave LLM_BASE_URL unset)
#
# Open-weight model on a hosted inference provider (HF router, vLLM, Groq,
# OpenRouter, Ollama, …):
#   HF_TOKEN=hf_...
#   LLM_BASE_URL=https://router.huggingface.co/v1
#   LLM_MODEL=your-org/gaida-qwen3-lora
#
# Local Ollama (free, offline):
#   HF_TOKEN=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:4b
#
# LLM_MODEL is resolved as LLM_MODEL, then OPENAI_MODEL, then gpt-4.1-mini.
# If no key is set, chat silently uses the scripted fallbacks.
HF_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_REASONING_EFFORT=medium

# ── Automatic fallback (recommended for a fine-tuned primary) ──
# If the fine-tuned host is down, cold, rate-limited, or its adapter was
# removed, the same request is retried here instead of dropping to scripted
# replies. Point this at the free/base model that already works (Groq below).
#
# LLM_FALLBACK_API_KEY may be omitted when the fallback uses the same key as
# the primary. LLM_FALLBACK_BASE_URL may be omitted for real OpenAI.
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# Replies are grounded in training/finetune.jsonl: the closest conversations
# from that file are injected as few-shot examples for the detected flow.
# Set to 0 to disable and use only the system prompt + hand-written exemplars.
FINETUNE_FEWSHOT=1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=REPLACE-WITH-YOUR-SUPABASE-KEY
GOOGLE_CLIENT_ID=REPLACE-WITH-YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com
# Demo accounts are enabled by default for thesis demonstrations.
# Set to 0 to disable them.
ALLOW_DEMO_ACCOUNTS=1
# JSON roster of currently enrolled students. Keep this in deployment secrets;
# never commit real student credentials.
STUDENT_ACCOUNTS=[]
# Optional additional test-only roster, used only when ALLOW_DEMO_ACCOUNTS=1.
DEMO_STUDENT_ACCOUNTS=[]

# Token signing keys. AUTH_SECRET signs login/session tokens.
# PARTICIPANT_TOKEN_SECRET signs anonymous research participant tokens; it
# falls back to AUTH_SECRET if unset. Without either, tokens are random per
# process and stop working after a server restart.
AUTH_SECRET=REPLACE-WITH-A-LONG-RANDOM-STRING
CAPTCHA_SECRET=REPLACE-WITH-A-DIFFERENT-LONG-RANDOM-STRING
PARTICIPANT_TOKEN_SECRET=REPLACE-WITH-A-DIFFERENT-LONG-RANDOM-STRING

# Optional counselor account and email configuration.
# Use real, unique passwords and addresses in deployment secrets.
COUNSELOR_ACCOUNTS=[]
COUNSELOR_EMAILS=

# Counselor alert emails (Crisis/High severity) — see app/services/notifications.py.
# If any of these are left blank, alert emails are silently skipped and only
# the Counselor Dashboard's Alerts list still works, as before.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE-WITH-SENDER-ADDRESS@gmail.com
SMTP_PASSWORD=REPLACE-WITH-APP-PASSWORD
ALERT_FROM_EMAIL=REPLACE-WITH-SENDER-ADDRESS@gmail.com
COUNSELOR_ALERT_EMAILS=counselor1@ue.edu.ph,counselor2@ue.edu.ph
ESCALATION_EMAILS=
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
